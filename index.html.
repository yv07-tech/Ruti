<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="theme-color" content="#58cc02" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>Ruti · Inglés Profesional y Comunicativo</title>
  <link rel="manifest" id="pwa-manifest" />
  <style>
    :root {
      --bg: #f7f8fa;
      --surface: #ffffff;
      --surface-alt: #f0f2f5;
      --text: #1f2937;
      --text-muted: #6b7280;
      --border: #e5e7eb;
      --border-bottom: #d1d5db;
      --primary: #58cc02;
      --primary-dark: #46a302;
      --secondary: #1cb0f6;
      --secondary-dark: #148bc4;
      --danger: #ff4b4b;
      --danger-dark: #d93838;
      --warning: #ffc800;
      --warning-dark: #d9a800;
      --purple: #ce82ff;
      --purple-dark: #a55eea;
      --shadow: 0 4px 12px rgba(0, 0, 0, 0.05);
      --radius: 16px;
    }

    [data-theme="dark"] {
      --bg: #131f24;
      --surface: #1b2a32;
      --surface-alt: #243741;
      --text: #f3f4f6;
      --text-muted: #9ca3af;
      --border: #2e4450;
      --border-bottom: #10191e;
      --shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      transition: background 0.25s, color 0.25s;
    }

    /* Header */
    header {
      background: var(--surface);
      border-bottom: 2px solid var(--border);
      padding: 12px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
    }

    .brand-logo {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      background: var(--primary);
      color: #fff;
      font-weight: 900;
      font-size: 20px;
      display: grid;
      place-items: center;
      box-shadow: 0 3px 0 var(--primary-dark);
    }

    .brand-title {
      font-weight: 800;
      font-size: 16px;
      line-height: 1.1;
    }

    .brand-sub {
      font-size: 11px;
      color: var(--text-muted);
      font-weight: 600;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .icon-btn {
      background: var(--surface-alt);
      border: 2px solid var(--border);
      color: var(--text);
      border-radius: 12px;
      padding: 7px 10px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: transform 0.1s;
    }

    .icon-btn:active {
      transform: translateY(2px);
    }

    /* Container */
    main {
      width: 100%;
      max-width: 720px;
      margin: 0 auto;
      padding: 18px 16px 40px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    /* Cards & Buttons */
    .card {
      background: var(--surface);
      border: 2px solid var(--border);
      border-bottom-width: 4px;
      border-radius: var(--radius);
      padding: 18px;
      box-shadow: var(--shadow);
      margin-bottom: 16px;
    }

    .badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      background: rgba(28, 176, 246, 0.15);
      color: var(--secondary);
      margin-bottom: 8px;
    }

    .badge.green {
      background: rgba(88, 204, 2, 0.15);
      color: var(--primary);
    }

    .badge.purple {
      background: rgba(206, 130, 255, 0.18);
      color: var(--purple);
    }

    h1, h2, h3 {
      margin: 0 0 8px;
    }

    .section-title {
      font-size: 15px;
      font-weight: 800;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin: 18px 0 10px;
    }

    /* Subject Selector */
    .subject-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }

    @media (min-width: 600px) {
      .subject-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .subject-card {
      background: var(--surface);
      border: 2px solid var(--border);
      border-bottom-width: 4px;
      border-radius: var(--radius);
      padding: 14px;
      cursor: pointer;
      transition: all 0.15s;
      text-align: left;
    }

    .subject-card.active {
      border-color: var(--secondary);
      background: rgba(28, 176, 246, 0.08);
    }

    .subject-card h3 {
      font-size: 15px;
      margin-bottom: 4px;
    }

    .subject-card p {
      margin: 0;
      font-size: 12px;
      color: var(--text-muted);
      line-height: 1.35;
    }

    /* Modes Grid */
    .modes-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    @media (min-width: 600px) {
      .modes-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .mode-btn {
      background: var(--surface);
      border: 2px solid var(--border);
      border-bottom-width: 4px;
      border-radius: 14px;
      padding: 14px 12px;
      cursor: pointer;
      text-align: left;
      display: flex;
      flex-direction: column;
      gap: 6px;
      color: var(--text);
      transition: transform 0.1s, border-color 0.15s;
    }

    .mode-btn:hover {
      border-color: var(--primary);
    }

    .mode-btn:active {
      transform: translateY(2px);
      border-bottom-width: 2px;
    }

    .mode-icon {
      font-size: 24px;
    }

    .mode-name {
      font-weight: 800;
      font-size: 14px;
    }

    .mode-desc {
      font-size: 11.5px;
      color: var(--text-muted);
      line-height: 1.3;
    }

    .mode-btn.featured {
      grid-column: 1 / -1;
      background: linear-gradient(135deg, rgba(88, 204, 2, 0.12), rgba(28, 176, 246, 0.12));
      border-color: var(--primary);
      flex-direction: row;
      align-items: center;
      gap: 14px;
    }

    /* Stats bar */
    .stats-row {
      display: flex;
      gap: 10px;
      margin-bottom: 12px;
    }

    .stat-pill {
      flex: 1;
      background: var(--surface);
      border: 2px solid var(--border);
      border-radius: 12px;
      padding: 8px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-weight: 800;
      font-size: 13px;
    }

    /* Lesson Screen */
    .lesson-top {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 18px;
    }

    .close-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 24px;
      font-weight: 800;
      cursor: pointer;
      padding: 4px;
    }

    .progress-track {
      flex: 1;
      height: 14px;
      background: var(--surface-alt);
      border-radius: 999px;
      overflow: hidden;
      border: 1px solid var(--border);
    }

    .progress-fill {
      height: 100%;
      background: var(--primary);
      width: 0%;
      transition: width 0.3s ease;
      border-radius: 999px;
    }

    .hearts {
      font-weight: 800;
      color: var(--danger);
      font-size: 15px;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .question-meta {
      font-size: 12px;
      font-weight: 800;
      color: var(--secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 6px;
    }

    .question-prompt {
      font-size: 20px;
      font-weight: 800;
      margin-bottom: 16px;
      line-height: 1.3;
    }

    /* Visual SVG Box */
    .visual-box {
      background: var(--surface-alt);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
      min-height: 150px;
    }

    .visual-box svg {
      width: 120px;
      height: 120px;
    }

    /* Audio Controls */
    .audio-panel {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      background: var(--surface-alt);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 18px;
    }

    .audio-play {
      background: var(--secondary);
      color: #fff;
      border: none;
      border-bottom: 4px solid var(--secondary-dark);
      border-radius: 16px;
      padding: 14px 22px;
      font-size: 18px;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .audio-slow {
      background: var(--surface);
      color: var(--secondary);
      border: 2px solid var(--border);
      border-bottom-width: 4px;
      border-radius: 16px;
      padding: 14px 16px;
      font-size: 15px;
      font-weight: 800;
      cursor: pointer;
    }

    .mini-speak {
      background: rgba(28, 176, 246, 0.14);
      color: var(--secondary);
      border: none;
      border-radius: 8px;
      padding: 4px 8px;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      margin-left: 6px;
    }

    /* Options */
    .options-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .option-btn {
      background: var(--surface);
      border: 2px solid var(--border);
      border-bottom-width: 4px;
      border-radius: 14px;
      padding: 14px 16px;
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
      text-align: left;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: all 0.1s;
    }

    .option-btn.selected {
      border-color: var(--secondary);
      background: rgba(28, 176, 246, 0.12);
      color: var(--secondary);
    }

    .option-btn.correct {
      border-color: var(--primary);
      background: rgba(88, 204, 2, 0.15);
      color: var(--primary);
    }

    .option-btn.wrong {
      border-color: var(--danger);
      background: rgba(255, 75, 75, 0.15);
      color: var(--danger);
    }

    .opt-num {
      display: inline-grid;
      place-items: center;
      width: 24px;
      height: 24px;
      border-radius: 7px;
      border: 1.5px solid var(--border);
      font-size: 12px;
      margin-right: 10px;
      flex-shrink: 0;
    }

    /* Writing Input */
    .write-box {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .write-input {
      width: 100%;
      padding: 15px;
      font-size: 17px;
      font-weight: 700;
      border-radius: 14px;
      border: 2px solid var(--border);
      border-bottom-width: 4px;
      background: var(--surface);
      color: var(--text);
      outline: none;
    }

    .write-input:focus {
      border-color: var(--secondary);
    }

    .hint-text {
      font-size: 13px;
      color: var(--warning-dark);
      font-weight: 700;
      background: rgba(255, 200, 0, 0.15);
      padding: 8px 12px;
      border-radius: 10px;
    }

    /* Sentence Builder */
    .sentence-slot {
      min-height: 64px;
      border: 2px dashed var(--border);
      border-radius: 14px;
      padding: 10px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 16px;
      background: var(--surface-alt);
    }

    .word-bank {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
    }

    .word-chip {
      background: var(--surface);
      border: 2px solid var(--border);
      border-bottom-width: 4px;
      border-radius: 12px;
      padding: 10px 14px;
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
      cursor: pointer;
    }

    .word-chip.used {
      opacity: 0.25;
      pointer-events: none;
    }

    /* Matching & Book Matches */
    .match-columns {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .match-col {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .match-item {
      background: var(--surface);
      border: 2px solid var(--border);
      border-bottom-width: 4px;
      border-radius: 12px;
      padding: 12px 10px;
      font-size: 13.5px;
      font-weight: 700;
      color: var(--text);
      cursor: pointer;
      text-align: left;
      line-height: 1.3;
      min-height: 54px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .match-item.selected {
      border-color: var(--secondary);
      background: rgba(28, 176, 246, 0.14);
    }

    .match-item.matched {
      border-color: var(--primary);
      background: rgba(88, 204, 2, 0.15);
      color: var(--primary);
      opacity: 0.65;
      pointer-events: none;
    }

    .match-item.error {
      border-color: var(--danger);
      background: rgba(255, 75, 75, 0.15);
    }

    .tag-key {
      display: inline-grid;
      place-items: center;
      min-width: 22px;
      height: 22px;
      border-radius: 6px;
      background: var(--surface-alt);
      font-size: 11px;
      font-weight: 900;
      color: var(--text-muted);
      flex-shrink: 0;
    }

    /* Action Footer */
    .lesson-footer {
      margin-top: auto;
      padding-top: 18px;
    }

    .primary-btn {
      width: 100%;
      background: var(--primary);
      color: #fff;
      border: none;
      border-bottom: 4px solid var(--primary-dark);
      border-radius: 14px;
      padding: 15px;
      font-size: 16px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      cursor: pointer;
    }

    .primary-btn:disabled {
      background: var(--border);
      border-bottom-color: var(--border-bottom);
      color: var(--text-muted);
      cursor: not-allowed;
    }

    .feedback-banner {
      border-radius: 14px;
      padding: 14px 16px;
      margin-bottom: 12px;
      font-weight: 700;
      font-size: 14px;
      line-height: 1.4;
    }

    .feedback-banner.ok {
      background: rgba(88, 204, 2, 0.16);
      border: 2px solid var(--primary);
      color: var(--primary-dark);
    }

    [data-theme="dark"] .feedback-banner.ok {
      color: #8ee000;
    }

    .feedback-banner.bad {
      background: rgba(255, 75, 75, 0.15);
      border: 2px solid var(--danger);
      color: var(--danger);
    }

    /* Modal / Glossary */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      z-index: 100;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    .modal-backdrop.open {
      display: flex;
    }

    .modal-card {
      background: var(--surface);
      border: 2px solid var(--border);
      border-radius: 18px;
      width: 100%;
      max-width: 600px;
      max-height: 85vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .modal-header {
      padding: 14px 16px;
      border-bottom: 2px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 800;
    }

    .modal-body {
      padding: 16px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .glossary-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 12px;
      border-radius: 12px;
      background: var(--surface-alt);
      gap: 10px;
    }

    .hidden {
      display: none !important;
    }
  </style>
</head>
<body>

  <header>
    <div class="brand" onclick="goHome()">
      <div class="brand-logo">R</div>
      <div>
        <div class="brand-title">Ruti</div>
        <div class="brand-sub">Inglés Profesional y Comunicativo</div>
      </div>
    </div>
    <div class="header-actions">
      <button class="icon-btn" onclick="openGlossary()">📖 Glosario</button>
      <button class="icon-btn" id="themeBtn" onclick="toggleTheme()">🌙</button>
    </div>
  </header>

  <main>
    <!-- HOME VIEW -->
    <section id="homeView">
      <div class="stats-row">
        <div class="stat-pill"><span>🔥 Racha</span><span id="streakStat">0</span></div>
        <div class="stat-pill"><span>⭐ XP Total</span><span id="xpStat">0</span></div>
        <div class="stat-pill"><span>📚 Vocabulario</span><span id="vocabCountStat">0</span></div>
      </div>

      <div class="section-title">1. Elige la asignatura</div>
      <div class="subject-grid">
        <div class="subject-card active" data-subj="all" onclick="selectSubject('all', this)">
          <span class="badge purple">Ambas materias</span>
          <h3>Examen Completo</h3>
          <p>Combina Habilidades Comunicativas (U.19) e Inglés Profesional (U.1-2).</p>
        </div>
        <div class="subject-card" data-subj="comm" onclick="selectSubject('comm', this)">
          <span class="badge">Unit 19 · PDF 1</span>
          <h3>Habilidades Comunicativas</h3>
          <p>Applying for a Job, entrevistas, adjetivos, salario, preaviso y condiciones.</p>
        </div>
        <div class="subject-card" data-subj="prof" onclick="selectSubject('prof', this)">
          <span class="badge green">Units 1 & 2 · PDF 2</span>
          <h3>Inglés Profesional</h3>
          <p>Cargos, oficina, direcciones, rutinas administrativas, material y facturas.</p>
        </div>
      </div>

      <div class="section-title">2. Elige el tipo de lección</div>
      <div class="modes-grid">
        <button class="mode-btn featured" onclick="startMode('mixed')">
          <span class="mode-icon">🎯</span>
          <div>
            <div class="mode-name">Lección Mixta (Simulacro de Examen)</div>
            <div class="mode-desc">Combina preguntas visuales, selección múltiple, huecos, escritura, matches, frases y audio.</div>
          </div>
        </button>

        <button class="mode-btn" onclick="startMode('visual')">
          <span class="mode-icon">🖼️</span>
          <div class="mode-name">Visual</div>
          <div class="mode-desc">Mira la ilustración e identifica la palabra o expresión.</div>
        </button>

        <button class="mode-btn" onclick="startMode('mcq')">
          <span class="mode-icon">✅</span>
          <div class="mode-name">Selección Múltiple</div>
          <div class="mode-desc">Preguntas de vocabulario y situaciones reales de examen.</div>
        </button>

        <button class="mode-btn" onclick="startMode('fill')">
          <span class="mode-icon">📝</span>
          <div class="mode-name">Completar Frases</div>
          <div class="mode-desc">Elige la palabra exacta que encaja en el hueco.</div>
        </button>

        <button class="mode-btn" onclick="startMode('write')">
          <span class="mode-icon">⌨️</span>
          <div class="mode-name">Escribir en Inglés</div>
          <div class="mode-desc">Escribe la traducción o término en inglés sin fallos.</div>
        </button>

        <button class="mode-btn" onclick="startMode('bookmatch')">
          <span class="mode-icon">🔗</span>
          <div class="mode-name">Matches (A ↔ 1)</div>
          <div class="mode-desc">Une definiciones, opuestos o mitades de frases (ej. A con 3).</div>
        </button>

        <button class="mode-btn" onclick="startMode('pairs')">
          <span class="mode-icon">⚡</span>
          <div class="mode-name">Parejas Rápidas</div>
          <div class="mode-desc">Conecta palabras en inglés con su significado en español.</div>
        </button>

        <button class="mode-btn" onclick="startMode('order')">
          <span class="mode-icon">🧩</span>
          <div class="mode-name">Ordenar Frase</div>
          <div class="mode-desc">Coloca las palabras en el orden sintáctico correcto.</div>
        </button>

        <button class="mode-btn" onclick="startMode('audio')">
          <span class="mode-icon">🎧</span>
          <div class="mode-name">Audio (Listening)</div>
          <div class="mode-desc">Escucha la pronunciación en inglés y elige qué significa.</div>
        </button>

        <button class="mode-btn" onclick="openGlossary()">
          <span class="mode-icon">📖</span>
          <div class="mode-name">Vocabulario</div>
          <div class="mode-desc">Repasa toda la lista con audio antes de practicar.</div>
        </button>
      </div>
    </section>

    <!-- LESSON VIEW -->
    <section id="lessonView" class="hidden">
      <div class="lesson-top">
        <button class="close-btn" onclick="goHome()">✕</button>
        <div class="progress-track">
          <div class="progress-fill" id="progressBar"></div>
        </div>
        <div class="hearts">❤️ <span id="heartsCount">5</span></div>
      </div>

      <div id="questionArea"></div>

      <div class="lesson-footer">
        <div id="feedbackBox" class="feedback-banner hidden"></div>
        <button id="checkBtn" class="primary-btn" onclick="handleMainAction()">Comprobar</button>
      </div>
    </section>

    <!-- SUMMARY VIEW -->
    <section id="summaryView" class="hidden">
      <div class="card" style="text-align:center; padding: 28px 18px;">
        <div style="font-size: 54px; margin-bottom: 10px;" id="summaryEmoji">🏆</div>
        <h2 id="summaryTitle">¡Lección completada!</h2>
        <p id="summarySubtitle" style="color: var(--text-muted); margin-bottom: 20px;"></p>
