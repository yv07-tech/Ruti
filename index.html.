      { subj: "prof", prompt: "How much has he ____ you for all the office supplies?", answer: "charged", options: ["charged", "paid", "ordered", "filed"], explain: "Charge = cobrar un precio por un producto o servicio." },
      { subj: "prof", prompt: "In the UK, you enter a building on the ____ floor.", answer: "ground", options: ["ground", "first", "top", "second"], explain: "En Reino Unido se entra por la 'ground floor' (planta baja)." }
    ];

    const WRITE_QUESTIONS = [
      { subj: "comm", prompt: "Escribe en inglés: 'sede central'", answer: "headquarters", hint: "Empieza por 'head...'" },
      { subj: "comm", prompt: "Escribe en inglés: 'trasladarse / reubicarse'", answer: "relocate", hint: "Empieza por 'relo...'" },
      { subj: "comm", prompt: "Escribe en inglés: 'preaviso (al dejar un trabajo)'", answer: "notice", hint: "6 letras, empieza por 'n'" },
      { subj: "comm", prompt: "Escribe en inglés: 'beneficio extra laboral'", answer: "perk", hint: "4 letras, empieza por 'p'" },
      { subj: "comm", prompt: "Escribe en inglés: 'salario inicial'", answer: "starting salary", hint: "Dos palabras: s_______ s_____" },
      { subj: "comm", prompt: "Escribe en inglés: 'extrovertido / sociable'", answer: "outgoing", hint: "Empieza por 'out...'" },
      { subj: "comm", prompt: "Escribe en inglés: 'bajo presión'", answer: "under pressure", hint: "Dos palabras: u____ p_______" },
      { subj: "prof", prompt: "Escribe en inglés: 'destructora de papel'", answer: "shredder", hint: "Empieza por 'shred...'" },
      { subj: "prof", prompt: "Escribe en inglés: 'factura'", answer: "invoice", hint: "7 letras, empieza por 'in...'" },
      { subj: "prof", prompt: "Escribe en inglés: 'planta baja'", answer: "ground floor", hint: "Dos palabras: g_____ f____" },
      { subj: "prof", prompt: "Escribe en inglés: 'enfrente de'", answer: "opposite", hint: "8 letras, empieza por 'opp...'" },
      { subj: "prof", prompt: "Escribe en inglés: 'quedarse sin (agotarse)'", answer: "run out of", hint: "Tres palabras: r__ o__ o_" },
      { subj: "prof", prompt: "Escribe en inglés: 'estar a cargo de'", answer: "be in charge of", hint: "Cuatro palabras: b_ i_ c_____ o_" }
    ];

    const BOOK_MATCH_SETS = [
      {
        subj: "comm",
        title: "Matches (A ↔ 1): Une cada adjetivo con su significado",
        pairs: [
          { left: "A. sensitive", right: "aware of other people's feelings" },
          { left: "B. creative", right: "can think of original ideas" },
          { left: "C. conscientious", right: "serious about doing duties right" },
          { left: "D. industrious", right: "hard-working" },
          { left: "E. easy-going", right: "pleasant and relaxed" }
        ]
      },
      {
        subj: "comm",
        title: "Matches (A ↔ 1): Une los opuestos de personalidad",
        pairs: [
          { left: "A. outgoing", right: "introverted" },
          { left: "B. insecure", right: "confident" },
          { left: "C. hard-working", right: "lazy" },
          { left: "D. organised", right: "messy" },
          { left: "E. permanent", right: "temporary" }
        ]
      },
      {
        subj: "prof",
        title: "Matches (A ↔ 1): Une cada cargo con su función",
        pairs: [
          { left: "A. Financial Director", right: "manages the company's money" },
          { left: "B. Marketing Director", right: "plans how to sell a product" },
          { left: "C. HR Director", right: "finds and trains new employees" },
          { left: "D. Head of IT", right: "looks after computer systems" },
          { left: "E. Sales Rep", right: "travels to sell products" }
        ]
      },
      {
        subj: "prof",
        title: "Matches (A ↔ 1): Une cada término de facturación con su definición",
        pairs: [
          { left: "A. price per unit", right: "how much each item costs" },
          { left: "B. subtotal", right: "price of items without tax" },
          { left: "C. shipping cost", right: "price of sending items" },
          { left: "D. invoice", right: "document listing ordered items" },
          { left: "E. delivery", right: "getting items to a customer" }
        ]
      }
    ];

    const ORDER_QUESTIONS = [
      { subj: "comm", prompt: "Ordena la pregunta de entrevista:", answer: "Could you tell me about your educational background?", words: ["Could", "you", "tell", "me", "about", "your", "educational", "background?"] },
      { subj: "comm", prompt: "Ordena la frase sobre trabajo bajo presión:", answer: "I'd like to know how well you work under pressure.", words: ["I'd", "like", "to", "know", "how", "well", "you", "work", "under", "pressure."] },
      { subj: "comm", prompt: "Ordena la respuesta del candidato:", answer: "I'm keen to succeed and flexible about hours.", words: ["I'm", "keen", "to", "succeed", "and", "flexible", "about", "hours."] },
      { subj: "prof", prompt: "Ordena la frase sobre ubicación en la oficina:", answer: "The Human Resources department is on the first floor.", words: ["The", "Human", "Resources", "department", "is", "on", "the", "first", "floor."] },
      { subj: "prof", prompt: "Ordena la petición educada de oficina:", answer: "Could you please e-mail the agenda to everyone?", words: ["Could", "you", "please", "e-mail", "the", "agenda", "to", "everyone?"] },
      { subj: "prof", prompt: "Ordena las indicaciones para llegar a una sala:", answer: "Walk to the end of the corridor and turn left.", words: ["Walk", "to", "the", "end", "of", "the", "corridor", "and", "turn", "left."] }
    ];

    /* ================= APP STATE ================= */
    let selectedSubj = "all";
    let currentQueue = [];
    let currentIndex = 0;
    let hearts = 5;
    let correctCount = 0;
    let totalQuestions = 0;
    let answered = false;

    let selectedOption = null;
    let builtSentence = [];
    let matchLeftSelected = null;
    let matchedCount = 0;

    function updateStatsUI() {
      document.getElementById("streakStat").textContent = localStorage.getItem("lingua_streak") || "0";
      document.getElementById("xpStat").textContent = localStorage.getItem("lingua_xp") || "0";
      document.getElementById("vocabCountStat").textContent = VOCAB_DB.length;
    }
    updateStatsUI();

    function selectSubject(subj, el) {
      selectedSubj = subj;
      document.querySelectorAll(".subject-card").forEach(c => c.classList.remove("active"));
      el.classList.add("active");
    }

    function filterBySubj(arr) {
      if (selectedSubj === "all") return [...arr];
      return arr.filter(item => item.subj === selectedSubj);
    }

    function shuffle(arr) {
      const a = [...arr];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    function buildAudioQuestions() {
      const pool = filterBySubj(VOCAB_DB);
      return shuffle(pool).slice(0, 8).map(item => {
        const distractors = shuffle(VOCAB_DB.filter(v => v.en !== item.en)).slice(0, 3).map(v => v.es);
        return {
          type: "audio",
          subj: item.subj,
          audioText: item.en,
          prompt: "Escucha y selecciona el significado correcto:",
          answer: item.es,
          options: shuffle([item.es, ...distractors]),
          explain: `${item.en} = ${item.es}`
        };
      });
    }

    function buildQuickPairQuestions() {
      const pool = shuffle(filterBySubj(VOCAB_DB));
      const sets = [];
      for (let i = 0; i < Math.min(3, Math.floor(pool.length / 5)); i++) {
        const slice = pool.slice(i * 5, i * 5 + 5);
        sets.push({
          type: "pairs",
          subj: selectedSubj,
          title: "Parejas Rápidas: Conecta cada palabra con su significado",
          pairs: slice.map(v => ({ left: v.en, right: v.es }))
        });
      }
      return sets;
    }

    function startMode(mode) {
      let q = [];
      if (mode === "visual") {
        q = shuffle(filterBySubj(VISUAL_QUESTIONS)).map(x => ({ ...x, type: "visual", options: shuffle(x.options) }));
      } else if (mode === "mcq") {
        q = shuffle(filterBySubj(MCQ_QUESTIONS)).map(x => ({ ...x, type: "mcq", options: shuffle(x.options) }));
      } else if (mode === "fill") {
        q = shuffle(filterBySubj(FILL_QUESTIONS)).map(x => ({ ...x, type: "fill", options: shuffle(x.options) }));
      } else if (mode === "write") {
        q = shuffle(filterBySubj(WRITE_QUESTIONS)).slice(0, 8).map(x => ({ ...x, type: "write" }));
      } else if (mode === "bookmatch") {
        q = shuffle(filterBySubj(BOOK_MATCH_SETS)).map(x => ({ ...x, type: "bookmatch" }));
      } else if (mode === "pairs") {
        q = buildQuickPairQuestions();
      } else if (mode === "order") {
        q = shuffle(filterBySubj(ORDER_QUESTIONS)).map(x => ({ ...x, type: "order" }));
      } else if (mode === "audio") {
        q = buildAudioQuestions();
      } else if (mode === "mixed") {
        const vis = shuffle(filterBySubj(VISUAL_QUESTIONS)).slice(0, 2).map(x => ({ ...x, type: "visual", options: shuffle(x.options) }));
        const mcq = shuffle(filterBySubj(MCQ_QUESTIONS)).slice(0, 2).map(x => ({ ...x, type: "mcq", options: shuffle(x.options) }));
        const fil = shuffle(filterBySubj(FILL_QUESTIONS)).slice(0, 2).map(x => ({ ...x, type: "fill", options: shuffle(x.options) }));
        const wrt = shuffle(filterBySubj(WRITE_QUESTIONS)).slice(0, 1).map(x => ({ ...x, type: "write" }));
        const bm = shuffle(filterBySubj(BOOK_MATCH_SETS)).slice(0, 1).map(x => ({ ...x, type: "bookmatch" }));
        const ord = shuffle(filterBySubj(ORDER_QUESTIONS)).slice(0, 1).map(x => ({ ...x, type: "order" }));
        const aud = buildAudioQuestions().slice(0, 1);
        q = shuffle([...vis, ...mcq, ...fil, ...wrt, ...bm, ...ord, ...aud]);
      }

      if (!q.length) return;
      currentQueue = q;
      currentIndex = 0;
      hearts = 5;
      correctCount = 0;
      totalQuestions = q.length;

      document.getElementById("homeView").classList.add("hidden");
      document.getElementById("summaryView").classList.add("hidden");
      document.getElementById("lessonView").classList.remove("hidden");
      renderQuestion();
    }

    function goHome() {
      document.getElementById("lessonView").classList.add("hidden");
      document.getElementById("summaryView").classList.add("hidden");
      document.getElementById("homeView").classList.remove("hidden");
      updateStatsUI();
    }

    function renderQuestion() {
      const q = currentQueue[currentIndex];
      answered = false;
      selectedOption = null;
      builtSentence = [];
      matchLeftSelected = null;
      matchedCount = 0;

      document.getElementById("heartsCount").textContent = hearts;
      document.getElementById("progressBar").style.width = `${(currentIndex / currentQueue.length) * 100}%`;

      const fb = document.getElementById("feedbackBox");
      fb.classList.add("hidden");
      fb.className = "feedback-banner hidden";

      const btn = document.getElementById("checkBtn");
      btn.textContent = "Comprobar";
      btn.disabled = true;

      const subjLabel = q.subj === "comm" ? "Habilidades Comunicativas" : q.subj === "prof" ? "Inglés Profesional" : "Examen Mixto";
      const area = document.getElementById("questionArea");

      if (q.type === "visual") {
        area.innerHTML = `
          <div class="question-meta">${subjLabel} · Visual</div>
          <div class="question-prompt">${q.prompt}</div>
          <div class="visual-box">${SVGS[q.svg] || ""}</div>
          <div class="options-list" id="optsContainer"></div>
        `;
        renderOptions(q.options, true);
      } else if (q.type === "mcq" || q.type === "fill") {
        area.innerHTML = `
          <div class="question-meta">${subjLabel} · ${q.type === "mcq" ? "Selección Múltiple" : "Completar Frase"}</div>
          <div class="question-prompt">${q.prompt}</div>
          <div class="options-list" id="optsContainer"></div>
        `;
        renderOptions(q.options, true);
      } else if (q.type === "audio") {
        area.innerHTML = `
          <div class="question-meta">${subjLabel} · Listening</div>
          <div class="question-prompt">${q.prompt}</div>
          <div class="audio-panel">
            <button class="audio-play" onclick="speak('${q.audioText.replace(/'/g, "\\'")}', 0.95)">🔊 Escuchar</button>
            <button class="audio-slow" onclick="speak('${q.audioText.replace(/'/g, "\\'")}', 0.65)">🐢 Lento</button>
          </div>
          <div class="options-list" id="optsContainer"></div>
        `;
        renderOptions(q.options, false);
        setTimeout(() => speak(q.audioText, 0.95), 250);
      } else if (q.type === "write") {
        area.innerHTML = `
          <div class="question-meta">${subjLabel} · Escribir en Inglés</div>
          <div class="question-prompt">${q.prompt}</div>
          <div class="write-box">
            <input type="text" id="writeInput" class="write-input" placeholder="Escribe aquí en inglés..." autocomplete="off" autocapitalize="none" oninput="onWriteInput()" onkeydown="if(event.key==='Enter' && !document.getElementById('checkBtn').disabled) handleMainAction()" />
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <button class="icon-btn" onclick="showHint()">💡 Pista</button>
              <span id="hintSlot" class="hint-text hidden">${q.hint}</span>
            </div>
          </div>
        `;
        setTimeout(() => document.getElementById("writeInput").focus(), 100);
      } else if (q.type === "order") {
        const shuffledWords = shuffle(q.words);
        area.innerHTML = `
          <div class="question-meta">${subjLabel} · Ordenar Frase</div>
          <div class="question-prompt">${q.prompt}</div>
          <div class="sentence-slot" id="sentenceSlot"></div>
          <div class="word-bank" id="wordBank"></div>
        `;
        const bank = document.getElementById("wordBank");
        shuffledWords.forEach((w, idx) => {
          const chip = document.createElement("button");
          chip.className = "word-chip";
          chip.textContent = w;
          chip.dataset.idx = idx;
          chip.onclick = () => addWordToSlot(w, idx, chip);
          bank.appendChild(chip);
        });
      } else if (q.type === "bookmatch" || q.type === "pairs") {
        const isBook = q.type === "bookmatch";
        const leftItems = q.pairs.map((p, idx) => ({ id: idx, text: p.left }));
        const rightItems = shuffle(q.pairs.map((p, idx) => ({ id: idx, text: p.right })));
        area.innerHTML = `
          <div class="question-meta">${subjLabel} · ${isBook ? "Matches (A ↔ 1)" : "Parejas Rápidas"}</div>
          <div class="question-prompt">${q.title}</div>
          <div class="match-columns">
            <div class="match-col" id="matchLeftCol"></div>
            <div class="match-col" id="matchRightCol"></div>
          </div>
        `;
        const lCol = document.getElementById("matchLeftCol");
        const rCol = document.getElementById("matchRightCol");

        leftItems.forEach(item => {
          const el = document.createElement("button");
          el.className = "match-item";
          el.dataset.id = item.id;
          el.innerHTML = `<span>${item.text}</span>`;
          el.onclick = () => selectMatchLeft(item.id, el, item.text);
          lCol.appendChild(el);
        });

        rightItems.forEach((item, idx) => {
          const el = document.createElement("button");
          el.className = "match-item";
          el.dataset.id = item.id;
          el.innerHTML = isBook
            ? `<span class="tag-key">${idx + 1}</span><span>${item.text}</span>`
            : `<span>${item.text}</span>`;
          el.onclick = () => selectMatchRight(item.id, el);
          rCol.appendChild(el);
        });
      }
    }

    function renderOptions(opts, speakEnglish) {
      const container = document.getElementById("optsContainer");
      opts.forEach((opt, i) => {
        const btn = document.createElement("button");
        btn.className = "option-btn";
        btn.innerHTML = `
          <div style="display:flex; align-items:center;">
            <span class="opt-num">${i + 1}</span>
            <span>${opt}</span>
          </div>
          ${speakEnglish ? `<span class="mini-speak" onclick="event.stopPropagation(); speak('${opt.replace(/'/g, "\\'")}')">🔊</span>` : ""}
        `;
        btn.onclick = () => {
          if (answered) return;
          selectedOption = opt;
          document.querySelectorAll(".option-btn").forEach(b => b.classList.remove("selected"));
          btn.classList.add("selected");
          if (speakEnglish) speak(opt);
          document.getElementById("checkBtn").disabled = false;
        };
        container.appendChild(btn);
      });
    }

    function onWriteInput() {
      const val = document.getElementById("writeInput").value.trim();
      document.getElementById("checkBtn").disabled = val.length === 0;
    }

    function showHint() {
      document.getElementById("hintSlot").classList.remove("hidden");
    }

    function addWordToSlot(word, idx, chipEl) {
      if (answered) return;
      chipEl.classList.add("used");
      builtSentence.push({ word, idx });
      renderSentenceSlot();
    }

    function renderSentenceSlot() {
      const slot = document.getElementById("sentenceSlot");
      slot.innerHTML = "";
      builtSentence.forEach((item, pos) => {
        const btn = document.createElement("button");
        btn.className = "word-chip";
        btn.textContent = item.word;
        btn.onclick = () => {
          if (answered) return;
          builtSentence.splice(pos, 1);
          const orig = document.querySelector(`#wordBank .word-chip[data-idx="${item.idx}"]`);
          if (orig) orig.classList.remove("used");
          renderSentenceSlot();
        };
        slot.appendChild(btn);
      });
      document.getElementById("checkBtn").disabled = builtSentence.length === 0;
    }

    function selectMatchLeft(id, el, text) {
      if (answered || el.classList.contains("matched")) return;
      document.querySelectorAll("#matchLeftCol .match-item").forEach(b => b.classList.remove("selected"));
      el.classList.add("selected");
      matchLeftSelected = { id, el };
      speak(text.replace(/^[A-E]\.\s*/, ""));
    }

    function selectMatchRight(id, el) {
      if (answered || !matchLeftSelected || el.classList.contains("matched")) return;
      const q = currentQueue[currentIndex];
      if (matchLeftSelected.id === id) {
        matchLeftSelected.el.classList.remove("selected");
        matchLeftSelected.el.classList.add("matched");
        el.classList.add("matched");
        matchLeftSelected = null;
        matchedCount++;
        if (matchedCount === q.pairs.length) {
          answered = true;
          correctCount++;
          showFeedback(true, "¡Todas las parejas conectadas correctamente!");
          document.getElementById("checkBtn").disabled = false;
          document.getElementById("checkBtn").textContent = "Continuar";
        }
      } else {
        el.classList.add("error");
        matchLeftSelected.el.classList.add("error");
        hearts = Math.max(0, hearts - 1);
        document.getElementById("heartsCount").textContent = hearts;
        const leftRef = matchLeftSelected.el;
        matchLeftSelected = null;
        setTimeout(() => {
          el.classList.remove("error");
          leftRef.classList.remove("error", "selected");
        }, 450);
      }
    }

    function normalizeText(str) {
      return str.toLowerCase().trim().replace(/[?.!,]/g, "").replace(/\s+/g, " ");
    }

    function handleMainAction() {
      const q = currentQueue[currentIndex];

      if (answered) {
        currentIndex++;
        if (hearts === 0 || currentIndex >= currentQueue.length) {
          finishLesson();
        } else {
          renderQuestion();
        }
        return;
      }

      let isCorrect = false;
      let detail = q.explain || `Respuesta correcta: ${q.answer}`;

      if (q.type === "visual" || q.type === "mcq" || q.type === "fill" || q.type === "audio") {
        isCorrect = selectedOption === q.answer;
        document.querySelectorAll(".option-btn").forEach(btn => {
          const txt = btn.querySelector("span:nth-child(2)").textContent;
          if (txt === q.answer) btn.classList.add("correct");
          else if (txt === selectedOption && !isCorrect) btn.classList.add("wrong");
        });
        if (q.type !== "audio") speak(q.answer);
      } else if (q.type === "write") {
        const userVal = document.getElementById("writeInput").value;
        isCorrect = normalizeText(userVal) === normalizeText(q.answer);
        speak(q.answer);
        detail = isCorrect ? `¡Exacto! "${q.answer}"` : `Se escribe: "${q.answer}"`;
      } else if (q.type === "order") {
        const userSentence = builtSentence.map(x => x.word).join(" ");
        isCorrect = userSentence === q.answer;
        speak(q.answer);
        detail = isCorrect ? "¡Orden perfecto!" : `Orden correcto: "${q.answer}"`;
      }

      answered = true;
      if (isCorrect) {
        correctCount++;
      } else {
        hearts = Math.max(0, hearts - 1);
        document.getElementById("heartsCount").textContent = hearts;
        currentQueue.push({ ...q });
      }

      showFeedback(isCorrect, detail);
      document.getElementById("checkBtn").textContent = hearts === 0 ? "Ver resultado" : "Continuar";
    }

    function showFeedback(ok, text) {
      const fb = document.getElementById("feedbackBox");
      fb.classList.remove("hidden");
      fb.className = `feedback-banner ${ok ? "ok" : "bad"}`;
      fb.innerHTML = `${ok ? "✅ ¡Correcto!" : "❌ Revisa esto:"} ${text}`;
    }

    function finishLesson() {
      document.getElementById("lessonView").classList.add("hidden");
      document.getElementById("summaryView").classList.remove("hidden");
      document.getElementById("progressBar").style.width = "100%";

      const acc = Math.round((correctCount / currentQueue.length) * 100);
      const earnedXp = correctCount * 10;

      const prevXp = parseInt(localStorage.getItem("lingua_xp") || "0", 10);
      const prevStreak = parseInt(localStorage.getItem("lingua_streak") || "0", 10);
      localStorage.setItem("lingua_xp", prevXp + earnedXp);
      if (hearts > 0) localStorage.setItem("lingua_streak", prevStreak + 1);

      document.getElementById("summaryEmoji").textContent = hearts > 0 ? "🏆" : "💪";
      document.getElementById("summaryTitle").textContent = hearts > 0 ? "¡Ronda completada!" : "¡Buen intento de repaso!";
      document.getElementById("summarySubtitle").textContent = hearts > 0
        ? "Has repasado todos los conceptos de este bloque."
        : "Te quedaste sin vidas, pero cada fallo te prepara mejor para el examen.";
      document.getElementById("sumAcc").textContent = `${acc}%`;
      document.getElementById("sumXp").textContent = `+${earnedXp} XP`;
    }

    /* ================= GLOSSARY ================= */
    function openGlossary() {
      document.getElementById("glossaryModal").classList.add("open");
      renderGlossary();
    }
    function closeGlossary() {
      document.getElementById("glossaryModal").classList.remove("open");
    }
    function renderGlossary() {
      const term = document.getElementById("glossarySearch").value.toLowerCase();
      const list = document.getElementById("glossaryList");
      const items = filterBySubj(VOCAB_DB).filter(v =>
        v.en.toLowerCase().includes(term) || v.es.toLowerCase().includes(term)
      );
      list.innerHTML = items.map(v => `
        <div class="glossary-item">
          <div>
            <div style="font-weight:800; font-size:15px;">${v.en}</div>
            <div style="font-size:13px; color:var(--text-muted);">${v.es}</div>
          </div>
          <button class="icon-btn" onclick="speak('${v.en.replace(/'/g, "\\'")}')">🔊</button>
        </div>
      `).join("");
    }
  </script>
</body>
</html>
